rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'createdAt', 'updatedAt'])
        && isValidId(data.uid)
        && data.uid == request.auth.uid
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 254
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 1024))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidProject(data) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'prompt', 'mlTaskType', 'blueprint', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'title', 'prompt', 'mlTaskType',
          'datasetId', 'datasetName', 'datasetSourceUrl',
          'clarifications', 'blueprint', 'status', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && isValidId(data.ownerId)
        && data.ownerId == request.auth.uid
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 200
        && data.prompt is string && data.prompt.size() >= 1 && data.prompt.size() <= 8000
        && data.mlTaskType is string && data.mlTaskType.size() >= 1 && data.mlTaskType.size() <= 120
        && (!('datasetId' in data) || (data.datasetId is string && data.datasetId.size() <= 128))
        && (!('datasetName' in data) || (data.datasetName is string && data.datasetName.size() <= 200))
        && (!('datasetSourceUrl' in data) || (data.datasetSourceUrl is string && data.datasetSourceUrl.size() <= 1024))
        && (!('clarifications' in data) || (
          data.clarifications is list
          && data.clarifications.size() <= 15
          && (data.clarifications.size() == 0 || data.clarifications[0] is map)
        ))
        && data.blueprint is map
        && data.blueprint.size() > 0
        && data.blueprint.size() <= 40
        && data.status in ['generated', 'archived']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;
      allow create: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(userId)
        && isOwner(userId)
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']);
      allow delete: if false;
    }

    match /projects/{projectId} {
      allow get: if isSignedIn()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;
      allow list: if isSignedIn()
        && resource.data.ownerId == request.auth.uid;
      allow create: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && incoming().id == projectId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isVerifiedUser()
        && isValidId(projectId)
        && isValidProject(incoming())
        && existing().ownerId == request.auth.uid
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          (
            existing().status != 'archived'
            && incoming().status == 'generated'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'prompt', 'mlTaskType',
              'datasetId', 'datasetName', 'datasetSourceUrl',
              'clarifications', 'blueprint', 'updatedAt'
            ])
          )
          ||
          (
            incoming().status == 'archived'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
          )
        );
      allow delete: if isVerifiedUser()
        && isValidId(projectId)
        && existing().ownerId == request.auth.uid;
    }
  }
}
